# NexLoop V0 — copy to .env and adjust.

# mock  = deterministic built-in provider (no API key, good for manual tests)
# openai = any OpenAI-compatible endpoint (OpenAI, llama.cpp, vLLM, Ark, DeepSeek, ...)
NEXLOOP_MODE=mock

# --- required only when NEXLOOP_MODE=openai ---
NEXLOOP_API_KEY=
NEXLOOP_BASE_URL=https://api.openai.com/v1
NEXLOOP_MODEL=gpt-4o-mini
# Some OpenAI-compatible servers don't support response_format json_object.
# Set to false if your endpoint errors on it (fallback: plain-text + JSON extraction).
NEXLOOP_JSON_MODE=true

# --- server ---
PORT=3000
HOST=127.0.0.1
