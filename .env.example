# NexLoop — copy to .env and adjust.

# Leave NEXLOOP_MODE unset for auto: real model when a key is present,
# zero-config demo otherwise. Set explicitly to "openai" (requires key) or
# "demo" (deterministic, no key).
# NEXLOOP_MODE=

# --- pacing: "the AI has its own pace" ---
# companion = human-like (default): first reply 60-120s, middle 20-60s,
#             closing line HELD until you've been silent 60-120s, then sent.
# demo      = same mechanics, compressed ranges for a 30s demo (2-5s / 3-7s / 6-10s).
# instant   = OFF switch: classic immediate chat, everything sent right away.
# scripted  = tests only: respect the model's own delay_ms, no hold.
NEXLOOP_TIMING_PRESET=companion

# Optional per-range overrides (ms), e.g. for tests or tuning:
# NEXLOOP_TIMING_FIRST_MS=2000,5000
# NEXLOOP_TIMING_MIDDLE_MS=3000,7000
# NEXLOOP_TIMING_HOLD_MS=6000,10000

# --- real model (any OpenAI-compatible endpoint) ---
NEXLOOP_API_KEY=
NEXLOOP_BASE_URL=https://api.openai.com/v1
NEXLOOP_MODEL=gpt-4o-mini
# Some endpoints don't support response_format json_object.
# Set to false if your endpoint errors on it (fallback: plain-text + JSON extraction).
NEXLOOP_JSON_MODE=true

# --- server ---
PORT=3000
HOST=127.0.0.1
