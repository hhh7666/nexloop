# NexLoop — copy to .env and adjust.

# Leave NEXLOOP_MODE unset for auto: real model when a key is present,
# zero-config demo otherwise. Set explicitly to "openai" (requires key) or
# "demo" (deterministic, no key).
# NEXLOOP_MODE=

# --- real model (any OpenAI-compatible endpoint) ---
NEXLOOP_API_KEY=
NEXLOOP_BASE_URL=https://api.openai.com/v1
NEXLOOP_MODEL=gpt-4o-mini
# Some endpoints don't support response_format json_object.
# Set to false if your endpoint errors on it (fallback: plain-text + JSON extraction).
NEXLOOP_JSON_MODE=true

# --- server ---
PORT=3000
HOST=127.0.0.1
